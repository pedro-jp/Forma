# Banco de Dados Supabase (basta esta única linha - suporta Pooler IPv4 ou Host Direto)
SUPABASE_DB_URL=jdbc:postgresql://aws-1-ca-central-1.pooler.supabase.com:5432/postgres?user=postgres.SEU_PROJETO&password=SUA_SENHA&sslmode=require&prepareThreshold=0

# Fail-closed de banco em produção (true somente para testes locais offline)
APP_ALLOW_H2_FALLBACK=false
APP_MIGRATION_H2_ENABLED=false

# Criptografia AES-256-GCM em repouso (tokens OAuth, IP MCI, AppConfig) & JWT (>= 32 chars)
APP_ENCRYPTION_KEY=TroquePorUmaChaveForteComPeloMenos32CaracteresAleatorios!
JWT_SECRET=TroquePorUmaChaveJwtComPeloMenos32CaracteresAleatorios!

# Origens CORS / WebSocket permitidas (lista separada por vírgulas)
APP_ALLOWED_ORIGINS=https://forma-94vp.onrender.com

# Autenticação Google, Apple Sign-In & E-mail Transacional
GOOGLE_CLIENT_ID=SEU_GOOGLE_CLIENT_ID.apps.googleusercontent.com
APPLE_BUNDLE_ID=com.joaovitor.Forma
APPLE_TEAM_ID=Q42LJ4LG32
APPLE_KEY_ID=SEU_APPLE_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
RESEND_API_KEY=re_seu_token_resend
APP_ALLOW_DEV_SOCIAL_MOCK=false

# Painel Admin (/admin) - NÃO use senha fraca ou padrão em produção
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque_por_uma_senha_forte
ADMIN_KEY=troque_por_uma_chave_admin_forte

# URL pública no Render (Keep-Alive)
RENDER_EXTERNAL_URL=https://forma-94vp.onrender.com
