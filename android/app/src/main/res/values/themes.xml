<resources>
    <!-- Segue o modo claro/escuro do sistema (como no iOS) -->
    <style name="Theme.Forma" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/forma_system_background</item>
        <item name="android:colorAccent">@color/forma_accent</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
